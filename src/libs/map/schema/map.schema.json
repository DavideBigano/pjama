{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Pjama map",
    "description": "A Pjama project map: its items and the relationships between them, in two flat collections. Every reference from one item to another is a relationship, except references inside atomic values (type expressions and test configs). This schema only keeps the map machine-readable: cardinality, references between items and other cross-item rules are checked by the map validator, not here.",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "Location of this JSON Schema, for editors and tools. It doesn't state which version of the map model the map follows: see schemaVersion.",
            "type": "string"
        },
        "schemaVersion": {
            "description": "Version of the map model the map is written in, as v<MAJ>.<MIN>.<PATCH>. Item and relationship types are versioned together with it. This schema only accepts maps written in its own version.",
            "const": "v0.1.0"
        },
        "id": {
            "description": "Random UUID identifying the map.",
            "$ref": "#/$defs/uuid"
        },
        "name": {
            "description": "Name of the map.",
            "type": "string"
        },
        "slug": {
            "description": "Derived from the name: diacritics dropped keeping the base letter, symbols other than letters, digits and spaces removed, repeated spaces collapsed, letters lowercased and the remaining spaces turned into hyphens.",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "root": {
            "description": "Path from the folder holding the map to the root of the project, in POSIX format. Every other path in the map is relative to this root.",
            "type": "string"
        },
        "items": {
            "description": "Every item of the map, of any type, except relationships.",
            "type": "array",
            "items": {
                "$ref": "#/$defs/anyItem"
            }
        },
        "relationships": {
            "description": "Every relationship of the map, of any type.",
            "type": "array",
            "items": {
                "$ref": "#/$defs/anyRelationship"
            }
        }
    },
    "required": [
        "schemaVersion",
        "id",
        "name",
        "slug",
        "root",
        "items",
        "relationships"
    ],
    "additionalProperties": false,
    "$defs": {
        "uuid": {
            "description": "Random UUID (RFC 4122, version 4).",
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "markdown": {
            "description": "Free-form text, rendered as markdown.",
            "type": "string"
        },
        "item": {
            "description": "Fields shared by every item. Only id and type are required: every other field of an item is optional.",
            "type": "object",
            "properties": {
                "id": {
                    "description": "Random UUID identifying the item. Item ids never collide.",
                    "$ref": "#/$defs/uuid"
                },
                "type": {
                    "description": "Namespaced type of the item, which decides its other fields. It never changes.",
                    "type": "string"
                }
            },
            "required": ["id", "type"]
        },
        "describedItem": {
            "description": "Fields shared by the primary items: components, specs, checks, resources, decisions and actors.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/item"
                }
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "notes": {
                    "description": "Free-form notes, rendered as markdown.",
                    "$ref": "#/$defs/markdown"
                }
            }
        },
        "specBase": {
            "description": "Fields shared by every spec. A spec states a constraint on the component holding it, linked through a spec-to-component relationship.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/describedItem"
                }
            ],
            "properties": {
                "category": {
                    "description": "Free-form category. The map's categories are the set of those used across its specs.",
                    "type": "string"
                }
            }
        },
        "anyItem": {
            "oneOf": [
                {
                    "$ref": "#/$defs/component"
                },
                {
                    "$ref": "#/$defs/requirement"
                },
                {
                    "$ref": "#/$defs/useCase"
                },
                {
                    "$ref": "#/$defs/interface"
                },
                {
                    "$ref": "#/$defs/snippet"
                },
                {
                    "$ref": "#/$defs/typeSpec"
                },
                {
                    "$ref": "#/$defs/mockup"
                },
                {
                    "$ref": "#/$defs/technology"
                },
                {
                    "$ref": "#/$defs/actor"
                },
                {
                    "$ref": "#/$defs/resource"
                },
                {
                    "$ref": "#/$defs/decision"
                },
                {
                    "$ref": "#/$defs/review"
                },
                {
                    "$ref": "#/$defs/test"
                },
                {
                    "$ref": "#/$defs/interfaceStatement"
                },
                {
                    "$ref": "#/$defs/useCasePrerequisite"
                },
                {
                    "$ref": "#/$defs/reviewCriterion"
                },
                {
                    "$ref": "#/$defs/step"
                },
                {
                    "$ref": "#/$defs/option"
                },
                {
                    "$ref": "#/$defs/parameter"
                }
            ]
        },
        "component": {
            "description": "A piece of the project. Its specs and resources are linked through relationships.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/describedItem"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/component"
                }
            },
            "unevaluatedProperties": false
        },
        "requirement": {
            "description": "An atomic statement about the component.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/specBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/requirement"
                }
            },
            "unevaluatedProperties": false
        },
        "useCase": {
            "description": "A sequence of actions pertinent to the component. Its steps, prerequisites and actors are linked through relationships.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/specBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/use-case"
                }
            },
            "unevaluatedProperties": false
        },
        "interface": {
            "description": "A contract with inputs and outputs. Its parameters and statements are linked through relationships, and its types are the ones visible to its component.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/specBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/interface"
                }
            },
            "unevaluatedProperties": false
        },
        "snippet": {
            "description": "Business logic given as a code snippet, in pseudocode or a real language.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/specBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/snippet"
                },
                "language": {
                    "description": "Language the body is written in. Without it, the body is pseudocode.",
                    "type": "string"
                },
                "body": {
                    "description": "The code, as free-form text.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "typeSpec": {
            "description": "A custom type. Its name is unique only within its component, and it reaches other components through flows like any other spec.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/specBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/type"
                },
                "definition": {
                    "$ref": "#/$defs/typeExpression"
                }
            },
            "unevaluatedProperties": false
        },
        "mockup": {
            "description": "A visual reference for a piece of UI, from a rough wireframe to a high-fidelity design. It shows either a resource, linked through a mockup-to-resource relationship, or inline HTML, which is shown when it has both.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/specBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/mockup"
                },
                "html": {
                    "description": "Inline HTML: a fragment of elements, rendered inside a blank HTML document, or a full HTML document. It is rendered isolated from the app displaying it, and its scripts are never executed.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "technology": {
            "description": "A technology, such as a language, framework or library, that the component is built with or must use. Its documentation is linked through relationships.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/specBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/technology"
                },
                "technology": {
                    "description": "Name of the technology, e.g. TypeScript. Separate from the spec's own name.",
                    "type": "string"
                },
                "version": {
                    "description": "Version or version range of the technology, in free form.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "actor": {
            "description": "Someone or something taking part in use cases.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/describedItem"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/actor"
                }
            },
            "unevaluatedProperties": false
        },
        "resource": {
            "description": "Supporting material: a file inside the project or a page at a URL. Resources don't take part in spec flows.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/describedItem"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/resource"
                },
                "location": {
                    "description": "Path of a file inside the project, relative to the project root in POSIX format, or a URL. A file's media type is inferred from its extension.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "decision": {
            "description": "A choice made about the project, why it was made and why the other options weren't. Its options, chosen option, references and overrides are linked through relationships. Its status is derived, not stored: overridden if another decision overrides it, otherwise closed if it is marked closed or has a chosen option, otherwise open.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/describedItem"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/decision"
                },
                "closed": {
                    "description": "Marks the decision closed, also when none of its options is chosen.",
                    "type": "boolean"
                },
                "rationale": {
                    "description": "Why the chosen option was picked over the others.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "review": {
            "description": "A manual check, assessed by a human or an agent. Its criteria and resources are linked through relationships. Its results and reviewers are not stored in the map.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/describedItem"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/review"
                },
                "instructions": {
                    "description": "How to carry out the review, as free-form text rendered as markdown.",
                    "$ref": "#/$defs/markdown"
                },
                "reviewer": {
                    "description": "Who must perform the review. Without it, either may.",
                    "enum": ["human", "agent"]
                }
            },
            "unevaluatedProperties": false
        },
        "test": {
            "description": "An automated, repeatable check run by a plugin. Its results are not stored in the map.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/describedItem"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/test"
                },
                "plugin": {
                    "description": "Name of the plugin that runs the test, e.g. @pjama/vitest-test.",
                    "type": "string"
                },
                "config": {
                    "description": "Plugin-specific settings, validated by the plugin's own schema. Read and written as a whole.",
                    "type": "object"
                }
            },
            "unevaluatedProperties": false
        },
        "interfaceStatement": {
            "description": "A precondition, postcondition, invariant or protocol of an interface, existing only in function of it.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/item"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/interface-statement"
                },
                "text": {
                    "description": "The statement.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "useCasePrerequisite": {
            "description": "A condition assumed to hold for a use case to apply, existing only in function of it.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/item"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/use-case-prerequisite"
                },
                "text": {
                    "description": "The condition.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "reviewCriterion": {
            "description": "A pass criterion of a review, existing only in function of it.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/item"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/review-criterion"
                },
                "text": {
                    "description": "The criterion.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "step": {
            "description": "One specific action of a use case. Steps are linked to each other through next and sibling relationships.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/item"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/use-case-step"
                },
                "text": {
                    "description": "Short description of the action.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "option": {
            "description": "An alternative considered by a decision.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/item"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/decision-option"
                },
                "text": {
                    "description": "The alternative.",
                    "type": "string"
                },
                "rejectedBecause": {
                    "description": "Why the option wasn't chosen.",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "parameter": {
            "description": "An input or output of an interface.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/item"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/interface-parameter"
                },
                "paramName": {
                    "description": "The parameter's name. Inputs are always named; outputs may be unnamed, e.g. a plain return value.",
                    "type": "string"
                },
                "comment": {
                    "type": "string"
                },
                "definition": {
                    "description": "The parameter's shape.",
                    "$ref": "#/$defs/typeExpression"
                }
            },
            "unevaluatedProperties": false
        },
        "typeExpression": {
            "description": "The shape of a type, which may contain other type expressions. A type may refer to itself. Read and written as a whole: references inside it are not relationships.",
            "oneOf": [
                {
                    "$ref": "#/$defs/primitiveType"
                },
                {
                    "$ref": "#/$defs/referenceType"
                },
                {
                    "$ref": "#/$defs/structType"
                },
                {
                    "$ref": "#/$defs/unionType"
                },
                {
                    "$ref": "#/$defs/arrayType"
                },
                {
                    "$ref": "#/$defs/mergeType"
                },
                {
                    "$ref": "#/$defs/constantType"
                }
            ]
        },
        "primitiveType": {
            "type": "object",
            "properties": {
                "kind": {
                    "const": "primitive"
                },
                "name": {
                    "description": "Free-form primitive name, e.g. string or int64, so the map isn't tied to one language's type system.",
                    "type": "string"
                }
            },
            "required": ["kind", "name"],
            "additionalProperties": false
        },
        "referenceType": {
            "type": "object",
            "properties": {
                "kind": {
                    "const": "reference"
                },
                "type": {
                    "description": "Id of a type spec visible to the referencing spec's component.",
                    "$ref": "#/$defs/uuid"
                }
            },
            "required": ["kind", "type"],
            "additionalProperties": false
        },
        "structType": {
            "type": "object",
            "properties": {
                "kind": {
                    "const": "struct"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "comment": {
                                "type": "string"
                            },
                            "type": {
                                "$ref": "#/$defs/typeExpression"
                            },
                            "optional": {
                                "description": "Whether the field may be absent. Fields are required by default.",
                                "type": "boolean"
                            }
                        },
                        "required": ["name", "type"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["kind", "fields"],
            "additionalProperties": false
        },
        "unionType": {
            "description": "One of several types.",
            "type": "object",
            "properties": {
                "kind": {
                    "const": "union"
                },
                "of": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "comment": {
                                "description": "What this alternative stands for.",
                                "type": "string"
                            },
                            "type": {
                                "$ref": "#/$defs/typeExpression"
                            }
                        },
                        "required": ["type"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["kind", "of"],
            "additionalProperties": false
        },
        "arrayType": {
            "type": "object",
            "properties": {
                "kind": {
                    "const": "array"
                },
                "of": {
                    "description": "Type of the array's elements.",
                    "$ref": "#/$defs/typeExpression"
                }
            },
            "required": ["kind", "of"],
            "additionalProperties": false
        },
        "mergeType": {
            "description": "All the fields of several structs, together.",
            "type": "object",
            "properties": {
                "kind": {
                    "const": "merge"
                },
                "of": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/typeExpression"
                    }
                }
            },
            "required": ["kind", "of"],
            "additionalProperties": false
        },
        "constantType": {
            "description": "A single value. Distinct from a custom type.",
            "type": "object",
            "properties": {
                "kind": {
                    "const": "constant"
                },
                "value": {
                    "description": "The value written as a raw literal, e.g. \"foo\" with its quotes, or 42.",
                    "type": "string"
                }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
        },
        "anyRelationship": {
            "oneOf": [
                {
                    "$ref": "#/$defs/containment"
                },
                {
                    "$ref": "#/$defs/dependency"
                },
                {
                    "$ref": "#/$defs/implementation"
                },
                {
                    "$ref": "#/$defs/enforcement"
                },
                {
                    "$ref": "#/$defs/derivation"
                },
                {
                    "$ref": "#/$defs/inputToInterface"
                },
                {
                    "$ref": "#/$defs/outputToInterface"
                },
                {
                    "$ref": "#/$defs/preconditionToInterface"
                },
                {
                    "$ref": "#/$defs/postconditionToInterface"
                },
                {
                    "$ref": "#/$defs/invariantToInterface"
                },
                {
                    "$ref": "#/$defs/protocolToInterface"
                },
                {
                    "$ref": "#/$defs/stepToUseCase"
                },
                {
                    "$ref": "#/$defs/prerequisiteToUseCase"
                },
                {
                    "$ref": "#/$defs/useCaseToActor"
                },
                {
                    "$ref": "#/$defs/stepToNext"
                },
                {
                    "$ref": "#/$defs/stepToSibling"
                },
                {
                    "$ref": "#/$defs/optionToDecision"
                },
                {
                    "$ref": "#/$defs/decisionToChosenOption"
                },
                {
                    "$ref": "#/$defs/decisionToReference"
                },
                {
                    "$ref": "#/$defs/decisionToOverride"
                },
                {
                    "$ref": "#/$defs/criterionToReview"
                },
                {
                    "$ref": "#/$defs/reviewToResource"
                },
                {
                    "$ref": "#/$defs/componentToResource"
                },
                {
                    "$ref": "#/$defs/technologyToDocumentation"
                },
                {
                    "$ref": "#/$defs/mockupToResource"
                },
                {
                    "$ref": "#/$defs/specToComponent"
                },
                {
                    "$ref": "#/$defs/dependencyToSelectedSpec"
                },
                {
                    "$ref": "#/$defs/implementationToExcludedSpec"
                }
            ]
        },
        "relationshipBase": {
            "description": "A directed edge from a source item to a target item. Relationships are items too, so they can be the source or target of other relationships.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/item"
                }
            ],
            "properties": {
                "source": {
                    "description": "Id of the item the edge starts from.",
                    "$ref": "#/$defs/uuid"
                },
                "target": {
                    "description": "Id of the item the edge points to.",
                    "$ref": "#/$defs/uuid"
                },
                "notes": {
                    "description": "Free-form notes, rendered as markdown.",
                    "$ref": "#/$defs/markdown"
                }
            },
            "required": ["source", "target"]
        },
        "orderedRelationshipBase": {
            "description": "A relationship of an ordered type, sorted among its siblings by position.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/relationshipBase"
                }
            ],
            "properties": {
                "position": {
                    "description": "Fractional key of any length, compared by plain code unit, never by locale. Relationships without one sort after the positioned ones, ordered among themselves by id.",
                    "type": "string"
                }
            }
        },
        "containment": {
            "description": "The source component (child) is part of the target component (parent). All specs pass both ways.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/relationshipBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/containment"
                }
            },
            "unevaluatedProperties": false
        },
        "dependency": {
            "description": "The source component (consumer) uses the target component (producer). Only the specs linked through dependency-to-selected-spec relationships pass.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/relationshipBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/dependency"
                },
                "action": {
                    "description": "The action the dependency represents. Without it, the action is \"uses\".",
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "implementation": {
            "description": "The source component (implementation) takes on the specs of the target component (definition), except the ones linked through implementation-to-excluded-spec relationships. Specs pass from the definition to the implementation only.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/relationshipBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/implementation"
                }
            },
            "unevaluatedProperties": false
        },
        "enforcement": {
            "description": "The source check enforces the target spec.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/$defs/relationshipBase"
                }
            ],
            "properties": {
                "type": {
                    "const": "@pjama/enforcement"
                }
            },
