{
  "name": "pjama",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm run typecheck && pnpm run lint && nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "lint": "biome check --write --unsafe",
    "build": "pnpm run typecheck && pnpm run lint && nx run-many -t build",
    "storybook": "pnpm --filter editor storybook",
    "editor": "pnpm run editor:start",
    "editor:start": "node src/scripts/editor/start.js",
    "editor:stop": "node src/scripts/editor/stop.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "nx": "23.3.0"
  },
  "packageManager": "pnpm@10.30.3"
}
